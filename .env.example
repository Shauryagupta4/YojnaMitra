# ==============================================================================
# YojanaMitra Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Fill in your valid API keys below.
# 3. For Vercel deployments, configure these exact variables in Project Settings -> Environment Variables.
# 4. NEVER commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# TinyFish Web Sentinel & Live Search/Fetch API Key (https://tinyfish.ai)
# Server-only environment variable (No VITE_ prefix)
# ------------------------------------------------------------------------------
TINYFISH_API_KEY=your_tinyfish_api_key_here

# ------------------------------------------------------------------------------
# OpenRouter Server-Side Configuration (https://openrouter.ai)
# Server-only environment variables (No VITE_ prefix)
# OPENROUTER_MODEL must be explicitly free (e.g. openrouter/free or a model ending in :free)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# ------------------------------------------------------------------------------
# Optional Legacy Groq Fallback Keys (https://console.groq.com)
# Server-only environment variables (No VITE_ prefix)
# ------------------------------------------------------------------------------
GROQ_API_KEY_ELIGIBILITY=your_groq_eligibility_api_key_here
GROQ_API_KEY_BACKUP=your_groq_backup_failover_api_key_here
GROQ_API_KEY_INTAKE=your_groq_intake_api_key_here
GROQ_API_KEY_ADVISOR=your_groq_advisor_api_key_here
GROQ_API_KEY_HEADLINES=your_groq_headlines_api_key_here

# ------------------------------------------------------------------------------
# Supabase Authentication & Database
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
# Firebase Authentication & Google Sign-In
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
